---
import { t } from '@/i18n/translate';
import type { PageProps } from './PageProps';

const { locale } = Astro.props as PageProps;
const endedText = t(locale, 'questionnaire.ended');
---
<div class="page-title page-title--centered">
  <h1>{endedText}</h1>
</div>
<div class="page-content">
  <div class="page-section page-section--centered page-section--indented">
    <p>{endedText}</p>
  </div>
</div>
