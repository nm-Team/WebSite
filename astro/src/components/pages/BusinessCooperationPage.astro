---
import { t } from '@/i18n/translate';
import type { PageProps } from './PageProps';

const { locale } = Astro.props as PageProps;
const businessEmailAddress = 'business@nmteam.xyz';
---
<style>
  .email-btn {
    display: inline-block;
    padding: 10px 22px;
    margin: 6px 0;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-align: center;
    border: none;
    border-radius: 999px;
    color: #1c1a12;
    background: var(--brand);
    box-shadow: var(--shadow-s);
    text-decoration: none;
    cursor: pointer;
    user-select: all;
    -webkit-user-select: all;
    -moz-user-select: all;
    transition: background 0.25s, transform 0.45s var(--ease-out), box-shadow 0.45s var(--ease-out);
  }

  .email-btn:hover,
  .email-btn:focus-visible {
    background: var(--logolike-yellow-lighter);
    transform: translateY(-1px);
    box-shadow: var(--shadow-m);
  }

  .email-btn:active {
    transform: translateY(0) scale(0.97);
    transition-duration: 0.12s;
  }
</style>
<div class="title center">
  <h1>{t(locale, 'business_cooperation.title')}</h1>
</div>
<div class="main">
  <div class="mainBlock">
    <p>{t(locale, 'business_cooperation.content_0')}</p>
    <p>
      <button class="email-btn" onclick={`window.location.href='mailto:${businessEmailAddress}'`}>{businessEmailAddress}</button>
      &nbsp;&nbsp;<a href="javascript:" onclick="copyEmail()">{t(locale, 'business_cooperation.copy_email')}</a>
    </p>
    <p>{t(locale, 'business_cooperation.content_1')}</p>
  </div>
</div>
<script is:inline define:vars={{ businessEmailAddress }}>
  window.copyEmail = function () {
    var tempInput = document.createElement('input');
    tempInput.value = businessEmailAddress;
    document.body.appendChild(tempInput);
    tempInput.select();
    document.execCommand('copy');
    document.body.removeChild(tempInput);
  };
</script>
