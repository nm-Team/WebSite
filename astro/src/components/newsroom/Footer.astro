---
import { getArchives, getCategories, getNewsPosts } from '@/lib/newsroom/content';
import { newsroomLabels } from '@/lib/newsroom/labels';
import { type NewsroomLocale, newsroomPath } from '@/lib/newsroom/paths';

interface Props { locale: NewsroomLocale }
const { locale } = Astro.props;
const labels = newsroomLabels(locale);
const posts = await getNewsPosts(locale);
const categories = getCategories(posts);
const archives = getArchives(posts, locale).slice(0, 5);
---
<footer id="newsroom-footer">
  <div class="footer-body">
    <div class="footer-table">
      <div class="footer-col"><div class="footer-col-title">{labels.categories}</div>{categories.map((category) => <a href={category.url}>{category.name}</a>)}</div>
      <div class="footer-col"><div class="footer-col-title">{labels.archives}</div>{archives.map((archive) => <a href={archive.url}>{archive.label}</a>)}</div>
      <div class="footer-col"><div class="footer-col-title">{labels.more}</div><a href={newsroomPath(locale, 'about/')}>{labels.about}</a><a href={`/${locale}/`}>{labels.website}</a><a href={newsroomPath(locale, 'rss.xml')}>RSS</a></div>
    </div>
  </div>
</footer>
