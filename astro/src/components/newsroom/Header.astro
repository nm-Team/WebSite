---
import SecondaryNavigation from '@/components/layout/SecondaryNavigation.astro';
import { categoryNames } from '@/lib/newsroom/content';
import { newsroomLabels } from '@/lib/newsroom/labels';
import { type NewsroomLocale, newsroomPath } from '@/lib/newsroom/paths';

interface Props { locale: NewsroomLocale }
const { locale } = Astro.props;
const labels = newsroomLabels(locale);
const links: { name: string; url: string; target?: string; rel?: string }[] = (['press-release', 'stories'] as const).map((slug) => ({
  name: categoryNames[slug][locale], url: newsroomPath(locale, `category/${slug}/`),
}));
links.push({ name: labels.search, url: newsroomPath(locale, 'search/') }, { name: 'RSS', url: newsroomPath(locale, 'rss.xml'), target: '_blank', rel: 'noopener' });
---
<SecondaryNavigation id="newsroom" title="Newsroom" href={newsroomPath(locale)} menuLabel={labels.menu} links={links} />
