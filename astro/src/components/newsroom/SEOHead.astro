---
import type { NewsPost } from '@/lib/newsroom/content';
import { newsroomLabels } from '@/lib/newsroom/labels';
import type { NewsroomAlternate } from '@/lib/newsroom/pages';
import { absoluteNewsroomUrl, defaultNewsImage, type NewsroomLocale, newsroomPath } from '@/lib/newsroom/paths';

interface Props {
  locale: NewsroomLocale;
  title: string;
  url: string;
  alternates: NewsroomAlternate[];
  post?: NewsPost;
  noindex?: boolean;
}
const { locale, title, url, alternates, post, noindex = false } = Astro.props;
const labels = newsroomLabels(locale);
const fullTitle = title === labels.title ? title : `${title} - ${labels.title}`;
const description = post?.description ?? labels.description;
const canonical = absoluteNewsroomUrl(url);
const image = absoluteNewsroomUrl(post?.image ?? defaultNewsImage);
const breadcrumbs = [{ name: labels.title, url: newsroomPath(locale) }, ...(post ? [{ name: post.category.name, url: post.category.url }] : []), ...(url !== newsroomPath(locale) ? [{ name: title, url }] : [])];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': 'https://nm.team/#organization', name: 'nmTeam', url: 'https://nm.team/', logo: 'https://nm.team/favicon.ico' },
    { '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: absoluteNewsroomUrl(item.url) })) },
    ...(post ? [{ '@type': 'NewsArticle', headline: post.title, description, image: [image], datePublished: post.dateTime, dateModified: post.updatedDateTime ?? post.dateTime, inLanguage: locale, mainEntityOfPage: canonical, url: canonical, author: { '@type': 'Organization', name: post.author }, publisher: { '@id': 'https://nm.team/#organization' }, articleSection: post.category.name, keywords: post.tags.map((tag) => tag.name) }] : []),
  ],
};
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex,follow" />}
<link rel="canonical" href={canonical} />
{alternates.map((alternate) => <link rel="alternate" hreflang={alternate.locale} href={absoluteNewsroomUrl(alternate.url)} />)}
<link rel="alternate" type="application/rss+xml" title={labels.title} href={newsroomPath(locale, 'rss.xml')} />
<meta property="og:site_name" content={labels.title} />
<meta property="og:type" content={post ? 'article' : 'website'} />
<meta property="og:locale" content={locale === 'zh-CN' ? 'zh_CN' : 'en_US'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content={post?.imageAlt ?? labels.title} />
{post && <><meta property="article:published_time" content={post.dateTime} /><meta property="article:modified_time" content={post.updatedDateTime ?? post.dateTime} /><meta property="article:section" content={post.category.name} /></>}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')}></script>
